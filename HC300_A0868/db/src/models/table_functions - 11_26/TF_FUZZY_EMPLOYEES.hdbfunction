/*  EXERCISE: CREATE A TABLE FUNCTION AND USE IT IN GRAPHICAL CALCULATION VIEWS 
    Used in CVD_FIND_EMPLOYEES and in CVD_FIND_EMPLOYEES_IP
*/
-- Input parameter to search: lastNameFilter
FUNCTION "HC::TF_FUZZY_EMPLOYEES" (lastNameFilter NVARCHAR(40))
	RETURNS table -- Return table
        ( 
       "FIRST_NAME" NVARCHAR(40),
       "LAST_NAME" NVARCHAR(40),
       "SEX" NVARCHAR(1),
       "LANGUAGE" NVARCHAR(1),
       "EMAIL_ADDRESS" NVARCHAR(255)
        )
	LANGUAGE SQLSCRIPT
	SQL SECURITY INVOKER AS
BEGIN
    RETURN

    select
    "FIRST_NAME",
    "LAST_NAME",
    "SEX",
    "LANGUAGE",
    "EMAIL_ADDRESS"
    -- Look into table: SNWD_EMPLOYEES
    from "HC::SNWD_EMPLOYEES"
    -- Search for last names that match the filter
    where contains("LAST_NAME", :lastNameFilter, FUZZY(0.5));
END;