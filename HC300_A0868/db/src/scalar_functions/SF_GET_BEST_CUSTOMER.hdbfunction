/*  SQLScript of your scalar function
    used in: CVC_SALES_IP_USING_FUNC
*/
FUNCTION "HC::SF_GET_BEST_CUSTOMER"( )
    RETURNS best_cust nvarchar(10)
    LANGUAGE SQLSCRIPT
    SQL SECURITY INVOKER AS

BEGIN

SELECT customer_id into best_cust
from "HC::SALES_DATA"
where quantity = (select max(quantity) from "HC::SALES_DATA");

END;